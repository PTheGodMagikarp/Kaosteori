clear plot

% Load data
a = importdata("Pointcare data uden state.csv", ',', 1);
time_exp = a.data(:, 1);      % Time (s)
theta_exp = a.data(:, 2);     % Angle (rad)
omega_exp = a.data(:, 3);     % Angular velocity (rad/s)

% Definition of parameters
gamma = 18.92;   % A/I
omega_yf = 6.1;  % Driving frequency (rad/s)
Fs = 20; % Sampling frequency (Hz)

% Calculate the driving force
Z = gamma * cos(omega_yf * time_exp);

% 2D figure
figure;
set(gcf, 'Color', 'w');
hold on;
title('2D Phase Portrait of Torsion Pendulum', 'FontSize', 12);
xlabel('\theta (rad)', 'FontSize', 12);
ylabel('\omega (rad/s)', 'FontSize', 12);
builtin('plot',theta_exp(1:15000), omega_exp(1:15000), 'b-', 'LineWidth', 1);
grid on;

% 3D figure
figure;
set(gcf, 'Color', 'w');
hold on;
title('3D Phase Portrait of Torsion Pendulum', 'FontSize', 12);
xlabel('X (\theta)', 'FontSize', 12);
ylabel('Y (\omega)', 'FontSize', 12);
zlabel('Z (\gamma cos(\omega_{yf} t))', 'FontSize', 12);
grid on;
view(30, 45);
builtin('plot3',theta_exp(1:15000), omega_exp(1:15000), Z(1:15000), 'b-', 'LineWidth', 1);
hold off;

% Plot angular frequency (omega) as a function of time
figure;  
set(gcf, 'Color', 'w');
hold on;
title('Angular Frequency vs. Time', 'FontSize', 12);
xlabel('Time (s)', 'FontSize', 12);
ylabel('\omega (rad/s)', 'FontSize', 12);
grid on;
builtin('plot',time_exp(1:100000), omega_exp(1:100000), 'b-', 'LineWidth', 1);
hold off;

% Plot Fourier transformation
figure;  
set(gcf, 'Color', 'w');
hold on;
title('Power Spectral Density', 'FontSize', 12);
xlabel('Frequency (Hz))', 'FontSize', 12);
ylabel('Power/Frequency (dB/Hz)', 'FontSize', 12);
grid on;

% Compute PSD
window = hamming(128);        % Window size
noverlap = 64;                % Overlap
nfft = 1024;                  % FFT points
[pxx_theta, f_theta] = pwelch(theta_exp, window, noverlap, nfft, Fs);
builtin('plot',f_theta, 10*log10(pxx_theta), 'b-', 'LineWidth', 1);
hold off;
